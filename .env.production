# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains ALL configuration for the arbitrage trading bot.
# Copy this to .env and fill in your actual values.
#
# SECURITY: Never commit .env to version control!
# Set file permissions: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# KALSHI API CONFIGURATION
# ------------------------------------------------------------------------------
# Kalshi API endpoints (production)
KALSHI_API_BASE=https://api.elections.kalshi.com
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Kalshi Authentication (choose one method)
# Method 1: Email/Password
KALSHI_EMAIL=your_kalshi_email@example.com
KALSHI_PASSWORD=your_kalshi_password_here

# Method 2: API Key (if available)
KALSHI_API_KEY=your_kalshi_api_key_here

# Kalshi Fee Structure
KALSHI_FEE_RATE=0.007  # 0.7% trading fee

# ------------------------------------------------------------------------------
# POLYMARKET API CONFIGURATION
# ------------------------------------------------------------------------------
# Polymarket API endpoints (production)
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Polymarket Authentication (optional for read-only)
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET=your_polymarket_secret_here

# Polymarket Fee Structure
POLYMARKET_FEE_RATE=0.02  # 2% trading fee (varies by market)

# ------------------------------------------------------------------------------
# BOT TRADING PARAMETERS
# ------------------------------------------------------------------------------
# Minimum profit per share to trigger an arbitrage trade (in dollars)
# Example: 0.01 = must make at least 1 cent per share profit
MIN_PROFIT_THRESHOLD=0.01

# Maximum number of shares to simulate per trade
# Limits exposure and ensures trades are within liquidity constraints
MAX_TRADE_SIZE=100

# Minimum order sizes (platform specific)
MIN_ORDER_SIZE_KALSHI=1
MIN_ORDER_SIZE_POLYMARKET=1

# ------------------------------------------------------------------------------
# PERFORMANCE & TIMING
# ------------------------------------------------------------------------------
# How often to scan for arbitrage opportunities (seconds)
# Lower = more frequent checks, higher CPU usage
# Recommended: 0.1 to 1.0 seconds
UPDATE_INTERVAL=0.1

# How often to refresh market list from APIs (seconds)
# Catches new markets but adds API load
# Recommended: 300-600 seconds (5-10 minutes)
MARKET_REFRESH_INTERVAL=300

# Heartbeat interval for health checks (seconds)
HEARTBEAT_INTERVAL=15

# Stale data threshold (seconds)
# Order book data older than this is considered unreliable
STALE_DATA_THRESHOLD=30

# WebSocket timeout (seconds)
# Reconnect if no messages received within this time
WEBSOCKET_TIMEOUT=30

# ------------------------------------------------------------------------------
# ERROR HANDLING & RESILIENCE
# ------------------------------------------------------------------------------
# Maximum WebSocket reconnection attempts before alerting
# -1 = infinite retries
MAX_RECONNECT_ATTEMPTS=10

# Base delay for exponential backoff (seconds)
# Actual delay = BASE * (2 ^ attempt_number)
RECONNECT_BASE_DELAY=2

# Circuit breaker configuration
# Threshold: Number of consecutive failures before opening circuit
CIRCUIT_BREAKER_THRESHOLD=5

# Timeout: Seconds to wait before attempting to close circuit
CIRCUIT_BREAKER_TIMEOUT=60

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
# Maximum API calls per second (to avoid rate limit bans)
KALSHI_RATE_LIMIT=10.0
POLYMARKET_RATE_LIMIT=10.0

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production: INFO or WARNING
# Development/Debugging: DEBUG
LOG_LEVEL=INFO

# Log file paths (relative to bot directory)
LOG_FILE=/var/log/arbitrage-bot/trading_bot.log
TRADE_LOG_FILE=/var/log/arbitrage-bot/trades.jsonl

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10 MB per file
LOG_BACKUP_COUNT=5      # Keep 5 backup files

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite database file path
DB_FILE=/var/lib/arbitrage-bot/trading_bot.db

# Database timeout (seconds)
DB_TIMEOUT=30

# ------------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Deployment environment
ENVIRONMENT=production

# Server IP (for documentation/monitoring)
SERVER_IP=159.65.170.253

# Bot version (update after code changes)
BOT_VERSION=1.0.0

# ------------------------------------------------------------------------------
# MONITORING & ALERTING (OPTIONAL)
# ------------------------------------------------------------------------------
# Email alerts for critical errors (requires email setup)
# ALERT_EMAIL=admin@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=bot@example.com
# SMTP_PASSWORD=your_smtp_password

# Slack webhook for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------------------------------------------
# ADVANCED SETTINGS (Leave as default unless you know what you're doing)
# ------------------------------------------------------------------------------
# Use uvloop for better performance (Linux/macOS only)
USE_UVLOOP=true

# Number of markets to track simultaneously
# Lower = less resource usage, might miss opportunities
# Higher = more coverage, higher resource usage
MAX_MARKETS_PER_PLATFORM=50

# Market pairing similarity threshold (0.0 to 1.0)
# Higher = stricter matching, fewer false positives
# Lower = more pairs, might match unrelated markets
MARKET_SIMILARITY_THRESHOLD=0.7

# ------------------------------------------------------------------------------
# NOTES
# ------------------------------------------------------------------------------
# 1. This bot runs in SIMULATION mode by default (no real trades)
# 2. All detected arbitrage opportunities are logged to trades.jsonl and SQLite
# 3. For production: Ensure log and data directories exist with correct permissions
# 4. Monitor disk space - logs and database can grow over time
# 5. Review and rotate logs periodically
# 6. Back up the SQLite database regularly
# ==============================================================================
