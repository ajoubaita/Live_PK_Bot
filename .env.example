# Kalshi API Configuration
KALSHI_API_BASE=https://api.elections.kalshi.com
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password_here
KALSHI_API_KEY=your_api_key_here

# Polymarket API Configuration
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here

# Bot Configuration
MIN_PROFIT_THRESHOLD=0.01  # Minimum profit per share to trigger arbitrage
MAX_TRADE_SIZE=100  # Maximum shares to simulate per trade
UPDATE_INTERVAL=0.1  # Seconds between arbitrage checks
MARKET_REFRESH_INTERVAL=300  # Seconds between market discovery refreshes

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
TRADE_LOG_FILE=trades.jsonl
DB_FILE=trading_bot.db

# Performance
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_BASE_DELAY=2  # Base delay for exponential backoff (seconds)
WEBSOCKET_TIMEOUT=30  # Seconds before considering WebSocket dead
HEARTBEAT_INTERVAL=15  # Seconds between heartbeat checks
